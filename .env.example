# Copy to .env.local and fill in. Never commit real values.

# --- Access (required) ---------------------------------------------------
# Single-owner login for /agent. Use a long, unique password and a random secret (openssl rand -hex 32).
AGENT_ACCESS_PASSWORD=change-me-to-a-long-passphrase
AGENT_SESSION_SECRET=replace-with-at-least-32-random-characters
# Local development only (ignored in production): skip the login screen.
# AGENT_AUTH_DISABLED=1

# --- Data ----------------------------------------------------------------
# Where the local store and private documents live (git-ignored). Default: ./data
# AGENT_DATA_DIR=./data

# --- LLM (optional; without one, tailoring is deterministic selection) -----
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=

# --- Scheduling -----------------------------------------------------------
# Used by POST/GET /api/agent/cron (Vercel Cron or any scheduler): Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=replace-with-at-least-24-random-characters

# --- Notifications (optional) ----------------------------------------------
# HTTPS webhook that accepts {"text": "..."} (Slack-compatible, ntfy, etc.)
# NOTIFY_WEBHOOK_URL=

# --- Authorised submission (all optional, all off by default) ---------------
# Recording a basis in Settings AND providing the credential are both required.
# GREENHOUSE_JOB_BOARD_API_KEY=
# Kill switch: disables every submission path.
# AGENT_DISABLE_SUBMISSION=1
# Sandbox employer for trying the submission flow; never contacts a real company.
# AGENT_ENABLE_SANDBOX=1

# --- Supabase (schema + RLS provided in supabase/migrations; not yet wired into the app) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
